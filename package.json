{
  "name": "my-next-apartment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/main.ts\"",
    "dev:ui": "vite",
    "dev:api": "tsx watch src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "collect": "tsx src/collect/cli.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
